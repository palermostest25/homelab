# /etc/sudoers.d/paperclip  --  Proxmox VE host (192.168.1.3)
# Owner: Warden (Paperclip). Install mode 0440, root:root.
# Validate before activating:  visudo -c -f /etc/sudoers.d/paperclip
#
# Scope rationale lives in homelab/README.md. Summary:
#   - Service lifecycle + log reading, so services can be deployed and debugged.
#   - Guest lifecycle EXCEPT destroy/delete, so a mistake cannot lose a VM.
#   - Read-only storage inspection for capacity-headroom checks before provisioning.
#   - Bounded space reclaim on `local`, reaching ISOs, templates, the apt cache
#     and orphaned vzdump temp dirs, but NEVER a guest disk (see PC_RECLAIM_*).
# Deliberately NOT granted: blanket ALL, pct/qm destroy, zfs destroy, pool ops,
# package INSTALLATION (`apt-get clean` only, which cannot fetch or unpack),
# `pvesm free` on guest-disk volids, and editing sudoers itself.

# --- Service lifecycle -------------------------------------------------------
# --no-pager is REQUIRED on status/list verbs. systemctl and journalctl invoke a
# pager by default, and less(1) offers a shell escape (!sh) which would turn a
# read-only grant into a root shell. Paged forms are intentionally not matched.
Cmnd_Alias PC_SYSTEMCTL_RW = \
    /usr/bin/systemctl start *, \
    /usr/bin/systemctl stop *, \
    /usr/bin/systemctl restart *, \
    /usr/bin/systemctl reload *, \
    /usr/bin/systemctl enable *, \
    /usr/bin/systemctl disable *, \
    /usr/bin/systemctl daemon-reload

Cmnd_Alias PC_SYSTEMCTL_RO = \
    /usr/bin/systemctl --no-pager status *, \
    /usr/bin/systemctl --no-pager list-units *, \
    /usr/bin/systemctl is-active *, \
    /usr/bin/systemctl is-enabled *, \
    /usr/bin/systemctl is-failed *

Cmnd_Alias PC_JOURNAL = /usr/bin/journalctl --no-pager *

# --- Proxmox guest lifecycle -------------------------------------------------
# Subcommands are enumerated rather than wildcarded at the binary, so that
# `pct destroy` / `qm destroy` are NOT reachable. Guest deletion is a
# destructive operation that requires explicit go-ahead in a ticket.
Cmnd_Alias PC_PCT = \
    /usr/sbin/pct list, \
    /usr/sbin/pct config *, \
    /usr/sbin/pct status *, \
    /usr/sbin/pct create *, \
    /usr/sbin/pct start *, \
    /usr/sbin/pct stop *, \
    /usr/sbin/pct shutdown *, \
    /usr/sbin/pct reboot *, \
    /usr/sbin/pct set *, \
    /usr/sbin/pct exec *, \
    /usr/sbin/pct push *, \
    /usr/sbin/pct pull *, \
    /usr/sbin/pct snapshot *, \
    /usr/sbin/pct template *

Cmnd_Alias PC_QM = \
    /usr/sbin/qm list, \
    /usr/sbin/qm config *, \
    /usr/sbin/qm status *, \
    /usr/sbin/qm create *, \
    /usr/sbin/qm start *, \
    /usr/sbin/qm stop *, \
    /usr/sbin/qm shutdown *, \
    /usr/sbin/qm reboot *, \
    /usr/sbin/qm set *, \
    /usr/sbin/qm snapshot *, \
    /usr/sbin/qm template *, \
    /usr/sbin/qm importdisk *

# --- Read-only inspection (capacity headroom before provisioning) ------------
Cmnd_Alias PC_INSPECT = \
    /usr/sbin/zpool list *, \
    /usr/sbin/zpool status *, \
    /usr/sbin/zfs list *, \
    /usr/sbin/zfs get *, \
    /usr/sbin/pvesm status, \
    /usr/sbin/pvesm list *, \
    /usr/bin/pveversion *

# --- Measurement (PJA-27) ----------------------------------------------------
# `du` as paperclip can only account for 95 G of the 211 G on `local`, because
# /var/lib/vz/images/<vmid>/ is root:root 0700. Without this, a capacity report
# for `local` is a guess. du never writes, and --max-depth/-x take no path that
# could be turned into an exec.
Cmnd_Alias PC_MEASURE = \
    /usr/bin/du -x --max-depth=[0-9] /var/lib/vz*, \
    /usr/bin/du -sh /var/lib/vz*, \
    /usr/bin/du -xh --max-depth=[0-9] /var/lib/vz*

# --- Space reclaim (PJA-27) --------------------------------------------------
# Install state 2026-09-29: `visudo -c` passes locally, NOT YET INSTALLED ON
# THE HOST — installing needs root on 192.168.1.3, which no agent has. The
# user's PJA-27 answer was install-full; a human with root runs:
#   scp access/sudoers.d/paperclip-proxmox root@192.168.1.3:/etc/sudoers.d/paperclip
#   ssh root@192.168.1.3 'chown root:root /etc/sudoers.d/paperclip && chmod 0440 /etc/sudoers.d/paperclip && visudo -c -f /etc/sudoers.d/paperclip'
# Human policy (AGENTS.md): plaintext SMB /etc/fstab entries on this host are
# accepted as-is; this drop-in does not touch them.
#
# The whole design constraint here is that reclaim must never be able to reach a
# guest disk. Two rules enforce that:
#
#   1. `pvesm free` is granted ONLY for the iso/ and vztmpl/ prefixes. NOTE: the
#      `:` in `local:iso/...` MUST be backslash-escaped (`local\:iso/*`) — an
#      unescaped colon is a visudo syntax error (verified with `visudo -c`,
#      sudo 1.9.9 / grammar 48). A sudoers `*` does not match `/`, so
#      `local:iso/*` cannot expand past the one path segment after `iso/`.
#      `local:132/vm-132-disk-0.qcow2` is unreachable by construction, not by
#      convention. Freeing an orphaned guest volume stays a destructive operation
#      needing explicit ticket go-ahead and a human.
#   2. `rm -rf` is granted only for two literal prefixes under /var/tmp, for the
#      same reason: `/var/tmp/vzdumptmp*` cannot match `/var/tmp/../anything`,
#      because that argument contains a `/` the wildcard will not cross.
#
# `rm` in a sudoers file is still the sharpest edge in this drop-in. It is here
# only because orphaned vzdump temp dirs are root-owned and there is no
# Proxmox-native verb that removes them. If that tradeoff is unwanted, drop
# PC_RECLAIM_TMP and leave those ~1 G to a human.
Cmnd_Alias PC_RECLAIM_STORE = \
    /usr/sbin/pvesm free local\:iso/*, \
    /usr/sbin/pvesm free local\:vztmpl/*

Cmnd_Alias PC_RECLAIM_APT = /usr/bin/apt-get clean

Cmnd_Alias PC_RECLAIM_TMP = \
    /usr/bin/rm -rf /var/tmp/vzdumptmp*, \
    /usr/bin/rm -rf /var/tmp/.guestfs-0

paperclip ALL=(root) NOPASSWD: PC_SYSTEMCTL_RW, PC_SYSTEMCTL_RO, PC_JOURNAL, \
                                PC_PCT, PC_QM, PC_INSPECT, PC_MEASURE, \
                                PC_RECLAIM_STORE, PC_RECLAIM_APT, PC_RECLAIM_TMP
